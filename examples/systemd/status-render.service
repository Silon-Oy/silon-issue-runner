[Unit]
Description=claude-issue-runner: status-render

[Service]
Type=oneshot
# Login shell on purpose — it loads nvm so npx/node resolve. Mirrors the
# plist's `/bin/bash -l -c`; a bare ExecStart would fail claude calls with 127.
ExecStart=/bin/bash -l -c '$HOME/.claude/scripts/run-issues/status-render.sh'
