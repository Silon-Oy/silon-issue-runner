[Unit]
Description=claude-issue-runner: pr-watch-poller
Documentation=https://github.com/Silon-Oy/claude-issue-runner

[Service]
Type=oneshot
# Login shell on purpose — it loads nvm so npx/node resolve. Mirrors the
# plist's `/bin/bash -l -c`; a bare ExecStart would fail claude calls with 127.
ExecStart=/bin/bash -l -c '$HOME/.claude/scripts/run-issues/pr-watch-poller.sh'
