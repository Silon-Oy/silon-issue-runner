[Unit]
Description=claude-issue-runner: action server (Ohjaamo)
# Tailscale must be up first: action-server.sh refuses to bind (exit 3) when
# `tailscale ip -4` yields nothing, rather than falling back to a wildcard.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash -l -c '$HOME/.claude/scripts/run-issues/action-server.sh'
# plist: KeepAlive with SuccessfulExit + ThrottleInterval
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
