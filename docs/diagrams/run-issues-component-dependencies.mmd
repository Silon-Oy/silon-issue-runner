%% /run-issues — component dependencies
%% Shows which scripts call which libs and how external systems hook in.
flowchart TB
    subgraph Triggers
        CMD["/run-issues slash command<br/>(interactive)"]
        POLL["poller.sh<br/>(LaunchAgent, Studio)"]
        CLEAN_CMD["/cleanup-run slash command<br/>(manual recovery)"]
        PR_CMD["/pr-watch slash command<br/>(interactive, Phase 2)"]
        PR_POLL["pr-watch-poller.sh<br/>(LaunchAgent, Studio)"]
    end

    subgraph Orchestrator
        ORCH["orchestrate.sh<br/>12-state machine"]
        CLEAN["cleanup-run.sh<br/>(DB drop + archive + worktree<br/>+ branch + run-dir + lock<br/>+ gh assignee teardown)"]
        PRWATCH["pr-watch.sh<br/>9-state PR watcher (Phase 2)"]
        PRLIB["lib/pr-watch-lib.sh<br/>(pr_decide classification)"]
    end

    subgraph Libraries["claude/scripts/run-issues/lib/"]
        L_LOCK["locking.sh"]
        L_ISSUE["issue.sh"]
        L_WT["worktree.sh"]
        L_STATE["state.sh"]
        L_CLAUDE["claude-call.sh"]
        L_HOOK["hook-runner.sh"]
    end

    subgraph Prompts["prompts/"]
        P_CR["01-cycle-review.md"]
        P_IMP["02-implementer.md"]
        P_EVO["03-evolution.md"]
    end

    subgraph DBClone["db-clone/"]
        DC_DISP["db-clone.sh<br/>(dispatcher)"]
        DC_WP["wordpress-mysql.sh"]
        DC_PG["postgres.sh"]
        DC_DC["docker-compose.sh"]
    end

    subgraph TargetRepo["target repo (worktree, opt-in)"]
        PTE[".claude/provision-test-env.sh<br/>(S7c hook: provision/cleanup &lt;run-id&gt;)"]
    end

    subgraph External
        GH["gh CLI<br/>(GitHub Issues + PRs)"]
        GIT["git worktree<br/>+ post-commit hook"]
        CC["claude CLI<br/>(--dangerously-skip-permissions)"]
        PCH["post-commit hook<br/>(POST_COMMIT_SYNC=1)"]
        DB["target repo DB<br/>(MySQL/PG/Compose)"]
        RES["per-run test resources<br/>(test DB / Redis / stub,<br/>run-id-isolated)"]
    end

    CMD --> ORCH
    POLL --> ORCH
    %% poller.sh also restarts timed_out runs: scan_timed_out reads each
    %% run.json (status=timed_out, retry_count<MAX, host gate) and launches
    %% orchestrate.sh --restart <run-dir> in a run-issues-restart-<N> tmux session.
    POLL -. "--restart timed_out runs<br/>(scan_timed_out)" .-> ORCH
    %% poller.sh also continues awaiting_clarification runs: scan_answered reads
    %% each local run.json (status=awaiting_clarification, round<MAX, host gate),
    %% then for those runs only calls gh (lib/issue.sh: parse_marker/detect_answer)
    %% to find maintainer's reply, and launches orchestrate.sh --continue <run-dir> in a
    %% run-issues-continue-<issue> tmux session.
    POLL -. "--continue answered runs<br/>(scan_answered)" .-> ORCH
    POLL -. reads run.json .-> L_STATE
    POLL -. "parse_marker / detect_answer" .-> L_ISSUE
    CLEAN_CMD --> CLEAN
    PR_CMD --> PRWATCH
    PR_POLL --> PRWATCH

    CLEAN -. reads .-> L_STATE
    CLEAN --> GH
    CLEAN --> GIT
    CLEAN --> DC_DISP
    %% cleanup-run.sh runs the provision hook's teardown BEFORE removing the
    %% worktree (the hook lives in the worktree), gated on run.json
    %% provision_test_env. Best-effort.
    CLEAN -. "cleanup &lt;run-id&gt; (best-effort)" .-> PTE

    PRWATCH --> PRLIB
    PRWATCH --> L_LOCK
    PRWATCH --> L_STATE
    PRWATCH --> GH
    PRWATCH --> GIT
    PRWATCH --> CLEAN

    ORCH --> L_LOCK
    ORCH --> L_ISSUE
    ORCH --> L_WT
    ORCH --> L_STATE
    ORCH --> L_CLAUDE
    ORCH --> L_HOOK
    ORCH --> DC_DISP
    %% S7c: orchestrate.sh runs the opt-in provision hook (provision <run-id>)
    %% after S7b, before S8, and injects its KEY=VALUE stdout into the implementer.
    ORCH -. "provision &lt;run-id&gt; (S7c, opt-in)" .-> PTE
    PTE --> RES

    L_ISSUE --> GH
    L_WT --> GIT
    L_CLAUDE --> CC
    L_HOOK --> PCH

    DC_DISP --> DC_WP
    DC_DISP --> DC_PG
    DC_DISP --> DC_DC
    DC_WP --> DB
    DC_PG --> DB
    DC_DC --> DB

    ORCH -. reads .-> P_CR
    ORCH -. reads .-> P_IMP
    ORCH -. reads .-> P_EVO

    %% Opt-in per-repo config: .claude/run-issues.json (claude_timeout_seconds)
    %% sets the base claude timeout, same convention as .claude/db-clone.json.
    RICFG[".claude/run-issues.json<br/>(opt-in: claude_timeout_seconds)"]
    ORCH -. reads .-> RICFG

    L_CLAUDE -. passes prompt .-> CC
