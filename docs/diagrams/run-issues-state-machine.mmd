%% /run-issues orchestrator — state machine
%% Source of truth for orchestrate.sh control flow. Update both together.
%%
%% Two-phase resume-capable machine:
%%   Phase A (S1..S6) runs from start. Review gate (S7) either decides
%%   automatically (RUN_ISSUES_AUTO=1) and continues to Phase B in the
%%   same invocation, or exits 10 ("awaiting_review") preserving lock +
%%   claim + worktree. A separate --resume <run-dir> --decision
%%   PROCEED|CANCEL invocation jumps to Phase B (S8..S12) or to
%%   resume_cancel.
stateDiagram-v2
    [*] --> S0_Idle

    %% ----- Phase A: pick → cycle-review -----
    S0_Idle --> S1_PickIssue: trigger (cmd or poller)
    S1_PickIssue --> S2_Lock: candidate found
    S1_PickIssue --> [*]: no candidate (rc=2)

    S2_Lock --> S3_Claim: lock acquired
    S2_Lock --> [*]: lock held by other run (rc=3)

    S3_Claim --> S4_Worktree: claim verified
    S3_Claim --> [*]: claim race lost (rc=3)

    %% S4 refreshes origin (refresh_origin) BEFORE branching so the worktree's
    %% base is the real remote tip. On a NEW run a stale base is unrecoverable,
    %% so a failed fetch is fail-fast. No origin remote -> skipped (local repo).
    %% (restart/continue also refresh origin, but softly — internal state_events,
    %% no state transition: a failed fetch there only risks a slightly stale
    %% RESTART_CONTEXT / cycle-review base and is non-fatal.)
    S4_Worktree --> S5_DBClone: origin fetched (or no origin) → worktree ready
    S4_Worktree --> [*]: origin fetch failed → blocked/origin_fetch_failed + needs-human (rc=5)
    S5_DBClone --> S6_CycleReview: clone ok or not needed
    S5_DBClone --> [*]: clone failed (rc=5)

    %% S6_CycleReview merges the GoodReason Strategist (Σ/χ) and Architect
    %% (β/τ) roles into one prompt (prompts/01-cycle-review.md) — there is no
    %% separate Architect call. Deliberate simplification; see CLAUDE.md.
    S6_CycleReview --> S7_ReviewGate: cycle-review output written

    %% ----- Review gate: auto resolves in-process; interactive exits 10 -----
    S7_ReviewGate --> S7b_EnvBootstrap: auto + PROCEED
    S7_ReviewGate --> [*]: auto + BLOCKER (rc=4)
    S7_ReviewGate --> S_AwaitingClarification: auto + NEEDS_CLARIFICATION (rc=11)
    S7_ReviewGate --> S_AwaitingReview: interactive (rc=10)

    %% ----- Resume entry from awaiting_review -----
    S_AwaitingReview --> S7b_EnvBootstrap: --resume --decision PROCEED
    S_AwaitingReview --> S_ResumeCancel: --resume --decision CANCEL
    S_ResumeCancel --> [*]: claim removed, worktree kept (rc=0)

    %% ----- S7b: fail-fast env bootstrap before the implementer -----
    %% Installs the worktree's dependencies (package manager detected from the
    %% root lockfile: pnpm-lock.yaml/yarn.lock/package-lock.json). This turns an
    %% environment obstacle (e.g. a missing GITHUB_TOKEN that breaks private
    %% @scope/* installs from GitHub Packages) into an immediate, diagnosable
    %% blocked run instead of a silent implementer timeout that burns the whole
    %% budget. No package.json -> no-op (the dotfiles repo itself). On every path
    %% that reaches phase_b (start, --resume, --restart, --continue) this is the
    %% single chokepoint before S8. Secrets come from a machine-local, gitignored
    %% env file (~/.config/run-issues/env) sourced at startup — never the repo.
    %%
    %% Each install (composer/pnpm/yarn/npm) is wrapped in
    %%   timeout --kill-after=60 ${RUN_ISSUES_ENV_BOOTSTRAP_TIMEOUT:-1200}
    %% so a hung install (issue #49: composer install stuck 48+h) cannot wedge
    %% the whole factory. rc=124 finalizes blocked/env_bootstrap_timeout —
    %% distinct from the rc!=0 env_bootstrap_failed reason so diagnosis stays
    %% separable in logs/issue comments.
    S7b_EnvBootstrap --> S7c_ProvisionTestEnv: install OK or no package.json
    S7b_EnvBootstrap --> [*]: install failed → blocked/env_bootstrap_failed + needs-human (rc=5)
    S7b_EnvBootstrap --> [*]: install timed out (rc=124) → blocked/env_bootstrap_timeout + needs-human (rc=5)

    %% ----- S7c: opt-in per-run test-env provisioning hook -----
    %% Runs the target repo's <worktree>/.claude/provision-test-env.sh
    %% (provision <run-id>) so a run gets whatever external resources its tests
    %% need — a migrated test database, Redis, … — provisioned automatically with
    %% run-id isolation, and injects their addresses as KEY=VALUE env vars into
    %% the implementer. Generalizes the db-clone pattern; the project owns the
    %% project-specific logic (migration command, conn-string shape). Placed
    %% AFTER S7b so the hook can rely on installed node_modules (e.g. pnpm prisma)
    %% and BEFORE S8 so the implementer's test run sees the injected vars. No hook
    %% / not executable -> no-op. Idempotent on every phase_b path. Static
    %% credentials come from the machine-local env file, never the committed hook.
    S7c_ProvisionTestEnv --> S8_Implementer: hook OK or no hook
    S7c_ProvisionTestEnv --> [*]: hook failed → blocked/provision_test_env_failed + needs-human (rc=5)

    %% ----- Phase B: implementer → PR -----
    S8_Implementer --> S9_Evolution: implementer SUCCESS / PARTIAL
    S8_Implementer --> [*]: implementer BLOCKED (rc=5)
    %% Timeout (claude rc=124, or a hard-kill caught by the cleanup trap):
    %% finalize status=timed_out + timeout_phase=S8_Implementer, exit 7. The
    %% per-run current_state field (written by enter_state at every step) is the
    %% durable record the trap reads to detect a non-terminal S8.
    S8_Implementer --> S_TimedOut: implementer TIMEOUT (rc=7)
    S9_Evolution --> S10_Push
    S10_Push --> S11_PRCreate
    S10_Push --> [*]: git push failed (rc=6)
    S11_PRCreate --> S12_Finalize: PR opened
    S11_PRCreate --> [*]: gh pr create failed (rc=6)
    S12_Finalize --> [*]

    %% ----- Timeout auto-restart loop -----
    %% A timed_out run is picked up by poller.sh's scan_timed_out (or a manual
    %% --restart) and re-enters Phase B with a ramped, capped timeout
    %% (base*(1+retry_count), cap RUN_ISSUES_CLAUDE_TIMEOUT_MAX). retry_count is
    %% incremented BEFORE the claude call so the spend is durable under the lock.
    %% Restart skips pick/claim — the lock + GitHub assignee persist.
    S_TimedOut --> S_RestartLoad: --restart (retry_count < MAX_RETRIES)
    S_TimedOut --> [*]: budget exhausted → needs-human (rc=0)
    S_RestartLoad --> S7b_EnvBootstrap: worktree OK, retry incremented, timeout ramped
    S_RestartLoad --> [*]: worktree corrupt → needs-human (rc=0)
    S_RestartLoad --> [*]: lock held by other run (rc=3)

    %% ----- Poller liveness sweep (issue #49) -----
    %% scan_stalled (poller.sh) detects an in-progress run whose state.jsonl's
    %% last event ts is older than RUN_ISSUES_STALE_AFTER (default 3600s). The
    %% threshold MUST exceed the longest legitimate single-phase claude call so
    %% a slow-but-progressing run is not killed mid-flight. finalize_stalled
    %% kills the tmux session (run-issues-<suffix> / run-issues-restart-<suffix>
    %% / run-issues-continue-<suffix>, where <suffix> carries the run's repo slug
    %% per issue #67), finalizes blocked/stalled_in_<current_state>,
    %% adds needs-human, posts a situation comment, releases the advisory lock.
    %% The session names AND the lock label come from the run's own recorded
    %% identity (run.json .repo_slug + .remote), so finalizing a stalled run in
    %% repo A can never kill repo B's session or delete B's lock for the same
    %% issue number (issue #67 cross-repo lock theft).
    %% awaiting_review and awaiting_clarification are NEVER stalled (documented
    %% human-wait contract). The sweep runs BEFORE the ACTIVE-cap check so a
    %% fully wedged GLOBAL_MAX (issue #49 root cause) can never short-circuit
    %% the cleanup. Host-gated like every other poller scan.
    %% Generic incoming arrow from any in-progress phase (S4..S9):
    S_StalledByPoller: poller scan_stalled detected stalled (no event for RUN_ISSUES_STALE_AFTER s)
    S4_Worktree --> S_StalledByPoller: state.jsonl stalled (host-gated)
    S5_DBClone --> S_StalledByPoller: state.jsonl stalled (host-gated)
    S6_CycleReview --> S_StalledByPoller: state.jsonl stalled (host-gated)
    S7b_EnvBootstrap --> S_StalledByPoller: state.jsonl stalled (host-gated)
    S7c_ProvisionTestEnv --> S_StalledByPoller: state.jsonl stalled (host-gated)
    S8_Implementer --> S_StalledByPoller: state.jsonl stalled (host-gated)
    S_StalledByPoller --> [*]: kill tmux + blocked/stalled_in_<state> + needs-human (rc=0, poller-side)

    %% ----- Clarification answer-and-continue loop -----
    %% NEEDS_CLARIFICATION parks the run as status=awaiting_clarification (rc=11):
    %% lock released, GitHub assignee + waiting label kept. The situation comment
    %% embeds an awaiting-answer marker (ts). poller.sh's scan_answered (host gate,
    %% round < MAX_CLARIFICATIONS) detects maintainer's reply by timestamp (detect_answer:
    %% createdAt > marker ts AND body lacks the run-issues: token) and launches
    %% orchestrate.sh --continue <run-dir> in a run-issues-continue-<issue> session.
    %% --continue re-runs S6 (run_cycle_review) with CLARIFICATION_CONTEXT built from
    %% the reply; clarification_round is incremented BEFORE the claude call.
    S_AwaitingClarification --> S_ContinueLoad: --continue (reply found, round < MAX)
    S_AwaitingClarification --> [*]: no reply yet (parked, rc=11)
    S_ContinueLoad --> S6_CycleReview: worktree OK, round incremented, context built
    S_ContinueLoad --> [*]: worktree corrupt / budget exhausted → needs-human (rc=0)
    S_ContinueLoad --> [*]: lock held by other run (rc=3)
    %% Re-run outcomes feed straight back through S7_ReviewGate:
    %%   PROCEED → remove waiting label → Phase B; still NEEDS_CLARIFICATION →
    %%   re-park (round+1, rc=11); BLOCKER → needs-human (rc=4, no loop).
